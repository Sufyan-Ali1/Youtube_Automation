# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Pexels (free at pexels.com/api — used for B-roll video in news frame) ────
PEXELS_API_KEY=...

# Google Cloud Text-to-Speech (English voiceover)
# Use a service-account JSON path, or any Application Default Credentials setup.
GOOGLE_APPLICATION_CREDENTIALS=config/google_cloud_service_account.json
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_VOICE_NAME=en-US-Neural2-J
GOOGLE_TTS_SPEAKING_RATE=1.05

# ── ElevenLabs ───────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID_YORUBA=...        # Yoruba voice ID (used in Module 3/4)

# ── HeyGen ───────────────────────────────────────────────────────────────────
HEYGEN_API_KEY=...
HEYGEN_AVATAR_ID=...                  # The chosen AI presenter avatar ID

# ── Creatomate ───────────────────────────────────────────────────────────────
CREATOMATE_API_KEY=...
CREATOMATE_TEMPLATE_ID_LANDSCAPE=...  # 16:9 branded news template ID
CREATOMATE_TEMPLATE_ID_VERTICAL=...   # 9:16 short-form template ID

# ── Canva ─────────────────────────────────────────────────────────────────────
CANVA_API_KEY=...
CANVA_THUMBNAIL_TEMPLATE_ID=...       # Thumbnail template ID

# ── Twitter / X ──────────────────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=...
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
TWITTER_ACCESS_TOKEN=...
TWITTER_ACCESS_SECRET=...

# ── YouTube ───────────────────────────────────────────────────────────────────
# Path to your OAuth2 client secrets JSON downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_PATH=config/youtube_client_secrets.json
YOUTUBE_TOKEN_PATH=config/youtube_token.json
# For the 24/7 livestream RTMP endpoint (from YouTube Studio > Go Live)

# ── Buffer ───────────────────────────────────────────────────────────────────
BUFFER_ACCESS_TOKEN=...
BUFFER_PROFILE_ID_YOUTUBE=...
BUFFER_PROFILE_ID_TIKTOK=...
BUFFER_PROFILE_ID_INSTAGRAM=...
BUFFER_PROFILE_ID_TWITTER=...

# API-Football / API-Sports live score dashboard
API_FOOTBALL_KEY=...
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
LIVE_SCORE_POLL_SECONDS=30
LIVE_SCORE_TIMEZONE=UTC

# YouTube OAuth used by this repo's live/upload automation
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
YOUTUBE_REFRESH_TOKEN=...
YOUTUBE_PLAYLIST_ID=

# YouTube Live automation
YOUTUBE_LIVE_STREAM_ID=...             # Reusable live stream ID from YouTube Studio / API
YOUTUBE_LIVE_PRIVACY_STATUS=unlisted
YOUTUBE_LIVE_CATEGORY_ID=17
LIVESTREAM_STREAM_KEY=...              # RTMP stream key used by FFmpeg

# Hetzner headless livestream controller
LIVESTREAM_BASE_URL=http://127.0.0.1:8000
LIVESTREAM_HOST=127.0.0.1
LIVESTREAM_PORT=8000
LIVESTREAM_TARGET_LEAGUE_ID=1
LIVESTREAM_TARGET_SEASON=2026
LIVESTREAM_POLL_SECONDS=30
LIVESTREAM_PREMATCH_LEAD_SECONDS=900
LIVESTREAM_POSTMATCH_GRACE_SECONDS=180
LIVESTREAM_DISPLAY=:99
LIVESTREAM_FRAME_WIDTH=1080
LIVESTREAM_FRAME_HEIGHT=1920
LIVESTREAM_FRAME_RATE=30
LIVESTREAM_CHROMIUM_BIN=chromium
LIVESTREAM_FFMPEG_BIN=ffmpeg
LIVESTREAM_XVFB_BIN=Xvfb
LIVESTREAM_AUDIO_FILE=
LIVESTREAM_VIDEO_BITRATE=4500k
LIVESTREAM_AUDIO_BITRATE=128k
LIVESTREAM_FFMPEG_PRESET=veryfast

# ── Google Drive ──────────────────────────────────────────────────────────────
# Path to service account JSON downloaded from Google Cloud Console
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=config/gdrive_service_account.json
GOOGLE_DRIVE_FOLDER_ID=...            # Root folder ID for this project

# ── Brand ─────────────────────────────────────────────────────────────────────
BRAND_NAME=Football Lacuna HQ
BRAND_TAGLINE=Football News. Every Second.
YOUTUBE_CHANNEL_ID=...
