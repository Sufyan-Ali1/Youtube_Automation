[Unit]
Description=Football AutoNews YouTube livestream controller
After=network.target football-frame.service
Requires=football-frame.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/football-autonews/Youtube_Automation
EnvironmentFile=/root/football-autonews/Youtube_Automation/.env
ExecStart=/usr/bin/python3 /root/football-autonews/Youtube_Automation/scripts/live_stream_controller.py
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
